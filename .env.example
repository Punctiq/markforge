# MarkForge configuration

FLASK_ENV=development
FLASK_DEBUG=true
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5000

# Optional personal-use Google OAuth login.
# Leave AUTH_ENABLED=false to keep local/dev behavior unchanged.
AUTH_ENABLED=false
AUTH_ALLOWED_EMAILS=you@example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/callback
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SECRET_KEY=change-this-to-a-long-random-secret-for-auth

# Production example for https://markforge.alexandru-raul.ro:
# FLASK_ENV=production
# AUTH_ENABLED=true
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY=true
# GOOGLE_OAUTH_REDIRECT_URI=https://markforge.alexandru-raul.ro/auth/callback

# Docker/container temp directory.
UPLOAD_TEMP_DIR=/tmp/markforge

# Optional server-side AI fallback.
# Leave empty if users will bring their own API keys in a future BYOK workflow.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# Examples:
# OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-latest

# Groq:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-70b-versatile

# xAI / Grok:
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4
# LLM_BASE_URL=https://api.x.ai/v1

#Optionals
#AI_QUALITY_MAX_OUTPUT_TOKENS=2048
#AI_QUALITY_SAFE_INPUT_TOKENS=24000
#AI_QUALITY_SAMPLE_CHARS=16000
#LLM_MAX_OUTPUT_TOKENS=8192
#LLM_CLEANUP_CONTEXT_WINDOW_TOKENS=32000
